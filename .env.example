# All variables use CODEATLAS_ and nested sections use a double underscore.
CODEATLAS_APPLICATION__ENVIRONMENT=development
CODEATLAS_APPLICATION__SERVICE_NAME=codeatlas
CODEATLAS_APPLICATION__SHUTDOWN_TIMEOUT_SECONDS=10

CODEATLAS_LOGGING__LEVEL=INFO
CODEATLAS_LOGGING__FORMAT=console

CODEATLAS_DATABASE__URL=sqlite:///./data/codeatlas.db
CODEATLAS_DATABASE__BUSY_TIMEOUT_SECONDS=5

CODEATLAS_QDRANT__ENABLED=false
CODEATLAS_QDRANT__URL=http://qdrant:6333
CODEATLAS_QDRANT__API_KEY=
CODEATLAS_QDRANT__TIMEOUT_SECONDS=10

CODEATLAS_OLLAMA__ENABLED=false
CODEATLAS_OLLAMA__BASE_URL=http://localhost:11434
CODEATLAS_OLLAMA__MODEL=
CODEATLAS_OLLAMA__TIMEOUT_SECONDS=60

CODEATLAS_DISCORD__ENABLED=false
CODEATLAS_DISCORD__TOKEN=
CODEATLAS_DISCORD__FORUM_CHANNEL_ID=

CODEATLAS_GITHUB__ENABLED=false
CODEATLAS_GITHUB__TOKEN=
CODEATLAS_GITHUB__WEBHOOK_SECRET=
CODEATLAS_GITHUB__API_URL=https://api.github.com
CODEATLAS_GITHUB__TIMEOUT_SECONDS=15

# JSON array, for example: ["org.example.plugin"]
CODEATLAS_SECURITY__PLUGIN_ALLOWLIST=[]
CODEATLAS_SECURITY__ALLOW_REPOSITORY_WRITES=false
CODEATLAS_SECURITY__MAX_HTTP_RESPONSE_BYTES=2000000

CODEATLAS_INDEXING__MAX_FILE_BYTES=1000000
CODEATLAS_INDEXING__MAX_REPOSITORY_FILES=100000
CODEATLAS_INDEXING__MAX_CONCURRENCY=4
CODEATLAS_INDEXING__OPERATION_TIMEOUT_SECONDS=300
