# All variables use CODEATLAS_ and nested sections use a double underscore.
CODEATLAS_APPLICATION__ENVIRONMENT=development
CODEATLAS_APPLICATION__SERVICE_NAME=codeatlas
CODEATLAS_APPLICATION__SHUTDOWN_TIMEOUT_SECONDS=10

CODEATLAS_LOGGING__LEVEL=INFO
CODEATLAS_LOGGING__FORMAT=console

CODEATLAS_DATABASE__URL=sqlite:///./data/codeatlas.db
CODEATLAS_DATABASE__BUSY_TIMEOUT_SECONDS=5
CODEATLAS_DATABASE__LEASE_TIMEOUT_SECONDS=120
CODEATLAS_DATABASE__LOCK_WAIT_TIMEOUT_SECONDS=5

CODEATLAS_QDRANT__ENABLED=false
CODEATLAS_QDRANT__URL=http://qdrant:6333
# CODEATLAS_QDRANT__API_KEY=replace-me
CODEATLAS_QDRANT__TIMEOUT_SECONDS=10

CODEATLAS_OLLAMA__ENABLED=false
CODEATLAS_OLLAMA__BASE_URL=http://localhost:11434
# CODEATLAS_OLLAMA__MODEL=ornith-1.5-9b:q4_k_m
CODEATLAS_OLLAMA__TIMEOUT_SECONDS=60
CODEATLAS_OLLAMA__KEEP_ALIVE=5m
CODEATLAS_OLLAMA__THINK=false
CODEATLAS_OLLAMA__MAX_RETRIES=2
CODEATLAS_OLLAMA__RETRY_BACKOFF_SECONDS=0.5
CODEATLAS_OLLAMA__NUM_CTX=8192

# Select DeepSeek by enabling this provider and disabling Ollama (only one may be enabled).
CODEATLAS_DEEPSEEK__ENABLED=false
# CODEATLAS_DEEPSEEK__API_KEY=replace-me
CODEATLAS_DEEPSEEK__BASE_URL=https://api.deepseek.com
CODEATLAS_DEEPSEEK__MODEL=deepseek-flash
CODEATLAS_DEEPSEEK__TIMEOUT_SECONDS=60
CODEATLAS_DEEPSEEK__MAX_RETRIES=2
CODEATLAS_DEEPSEEK__RETRY_BACKOFF_SECONDS=0.5
CODEATLAS_DEEPSEEK__THINKING=false

# External model providers (enable at most one overall).
CODEATLAS_OPENAI__ENABLED=false
# CODEATLAS_OPENAI__API_KEY=replace-me
CODEATLAS_OPENAI__MODEL=gpt-4.1-mini
CODEATLAS_OPENAI__BASE_URL=https://api.openai.com/v1

CODEATLAS_ANTHROPIC__ENABLED=false
# CODEATLAS_ANTHROPIC__API_KEY=replace-me
CODEATLAS_ANTHROPIC__MODEL=claude-sonnet-4-5
CODEATLAS_ANTHROPIC__BASE_URL=https://api.anthropic.com

CODEATLAS_GEMINI__ENABLED=false
# CODEATLAS_GEMINI__API_KEY=replace-me
CODEATLAS_GEMINI__MODEL=gemini-2.5-flash
CODEATLAS_GEMINI__BASE_URL=https://generativelanguage.googleapis.com

CODEATLAS_DISCORD__ENABLED=false
# CODEATLAS_DISCORD__TOKEN=replace-me
# CODEATLAS_DISCORD__FORUM_CHANNEL_ID=123456789012345678
CODEATLAS_DISCORD__REPLY_POLICY=mention_or_reply
CODEATLAS_DISCORD__HISTORY_LIMIT=12
CODEATLAS_DISCORD__TYPING_INTERVAL_SECONDS=8
CODEATLAS_DISCORD__MAX_RESPONSE_CHARS=1900
CODEATLAS_DISCORD__LOCALE=ja
CODEATLAS_DISCORD__IGNORE_BOTS=true
CODEATLAS_DISCORD__ANSWER_NEW_FORUM_POSTS=true

CODEATLAS_GITHUB__ENABLED=false
# CODEATLAS_GITHUB__TOKEN=replace-me
# CODEATLAS_GITHUB__WEBHOOK_SECRET=replace-me
CODEATLAS_GITHUB__API_URL=https://api.github.com
CODEATLAS_GITHUB__TIMEOUT_SECONDS=15
# CODEATLAS_GITHUB__DEFAULT_REPOSITORY=evex-dev/linejs
# CODEATLAS_GITHUB__WEBHOOK_REPOSITORY=evex-dev/linejs
# CODEATLAS_GITHUB__WEBHOOK_REPOSITORY_ID=repo_00000000000000000000000000000000

CODEATLAS_API__ENABLED=false
CODEATLAS_API__HOST=127.0.0.1
CODEATLAS_API__PORT=8080
CODEATLAS_API__MAX_BODY_BYTES=1000000
CODEATLAS_API__ALLOW_ASK=true

CODEATLAS_EMBEDDING__ENABLED=false
CODEATLAS_EMBEDDING__PROVIDER=openai-compatible
# CODEATLAS_EMBEDDING__API_KEY=replace-me
CODEATLAS_EMBEDDING__API_URL=https://api.openai.com/v1
CODEATLAS_EMBEDDING__MODEL=text-embedding-3-small
CODEATLAS_EMBEDDING__DIMENSIONS=1536
CODEATLAS_EMBEDDING__BATCH_SIZE=16

CODEATLAS_QDRANT__ENABLED=false
CODEATLAS_QDRANT__URL=http://127.0.0.1:6333
# CODEATLAS_QDRANT__API_KEY=replace-me
CODEATLAS_QDRANT__COLLECTION=codeatlas_chunks

# Unset: built-in plugins only. []: reject all. ["org.example.plugin"]: listed IDs only.
# CODEATLAS_SECURITY__PLUGIN_ALLOWLIST=["org.example.plugin"]
CODEATLAS_SECURITY__ALLOW_REPOSITORY_WRITES=false
CODEATLAS_SECURITY__MAX_HTTP_RESPONSE_BYTES=2000000

CODEATLAS_INDEXING__MAX_FILE_BYTES=1000000
CODEATLAS_INDEXING__MAX_REPOSITORY_FILES=100000
CODEATLAS_INDEXING__MAX_CONCURRENCY=4
CODEATLAS_INDEXING__OPERATION_TIMEOUT_SECONDS=300
CODEATLAS_INDEXING__MAX_PARSER_NODES=200000
CODEATLAS_INDEXING__MAX_PARSER_DEPTH=512
CODEATLAS_INDEXING__MAX_FAILURE_RATE=0.05
CODEATLAS_INDEXING__EXCLUDE_GENERATED=true
CODEATLAS_INDEXING__EXCLUDE_MINIFIED=true

CODEATLAS_REPOSITORY__GIT_EXECUTABLE=git
CODEATLAS_REPOSITORY__RIPGREP_EXECUTABLE=rg
CODEATLAS_REPOSITORY__MAX_REPOSITORY_BYTES=2147483648
CODEATLAS_REPOSITORY__MAX_TEXT_FILE_BYTES=1048576
CODEATLAS_REPOSITORY__MAX_SEARCH_FILE_BYTES=1048576
CODEATLAS_REPOSITORY__MAX_DIRECTORY_ENTRIES=1000
CODEATLAS_REPOSITORY__MAX_SEARCH_RESULTS=100
CODEATLAS_REPOSITORY__MAX_DIFF_BYTES=2097152
CODEATLAS_REPOSITORY__MAX_COMMAND_OUTPUT_BYTES=4194304
CODEATLAS_REPOSITORY__COMMAND_TIMEOUT_SECONDS=30
CODEATLAS_REPOSITORY__DETECT_RENAMES=true
# Explicitly approved local repositories registered at service startup (comma-separated or JSON list).
# CODEATLAS_REPOSITORY__REGISTERED_PATHS=["C:/approved/repositories/linejs"]
CODEATLAS_REPOSITORY__REGISTERED_PATHS=[]

CODEATLAS_AGENT__MAX_ITERATIONS=3
CODEATLAS_AGENT__MAX_TOOL_CALLS=12
CODEATLAS_AGENT__DEADLINE_SECONDS=90
CODEATLAS_AGENT__MAX_EVIDENCE=12
CODEATLAS_AGENT__MAX_PLAN_STEPS=6
CODEATLAS_AGENT__MAX_RESPONSE_CHARS=6000
CODEATLAS_AGENT__TEMPERATURE=0.2
CODEATLAS_AGENT__MAX_OUTPUT_TOKENS=1200
CODEATLAS_AGENT__MODEL_TIMEOUT_SECONDS=60
CODEATLAS_AGENT__USE_MODEL_PLANNER=false
CODEATLAS_AGENT__FALLBACK_WITHOUT_MODEL=true

CODEATLAS_CONVERSATION__HISTORY_LIMIT=12
CODEATLAS_CONVERSATION__RETENTION_DAYS=30
CODEATLAS_CONVERSATION__THREAD_LOCK_WAIT_SECONDS=20
CODEATLAS_CONVERSATION__THREAD_LOCK_LEASE_SECONDS=300
